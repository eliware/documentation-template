{
  "name": "@eliware/documentation-template",
  "version": "9.0.0",
  "private": true,
  "description": "Eliware documentation-only repository template.",
  "keywords": [
    "eliware",
    "documentation",
    "template"
  ],
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/documentation-template.git"
  },
  "bugs": {
    "url": "https://github.com/eliware/documentation-template/issues"
  },
  "homepage": "https://github.com/eliware/documentation-template#readme",
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "eliware": {
    "apply": [
      "general",
      "documentation",
      "private"
    ]
  },
  "jest": {},
  "devDependencies": {
    "@eliware/test": "^9.0.0"
  }
}
